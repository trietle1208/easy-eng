{
  "name": "easy-english",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "SKIP_ENV_VALIDATION=1 next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:promote-admin": "tsx --env-file=.env scripts/promote-admin.ts",
    "db:dump-content": "tsx scripts/dump-content-from-mocks.ts",
    "db:reset": "tsx --env-file=.env scripts/db-reset.ts",
    "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=.env ./node_modules/vitest/vitest.mjs",
    "test:coverage": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "playwright test",
    "db:bundle-migrate": "esbuild src/db/migrate.ts --bundle --platform=node --format=cjs --outfile=scripts/migrate.cjs",
    "db:bundle-seed": "esbuild scripts/seed.ts --bundle --platform=node --format=cjs --outfile=scripts/seed.cjs --external:pg-native"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "15.5.26",
    "next-themes": "^0.4.6",
    "nodemailer": "10.0.12",
    "pg": "8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.89.0",
    "react-rough-notation": "^1.0.8",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "5.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "3.2.4",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.25.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "4.20.5",
    "typescript": "^5",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
