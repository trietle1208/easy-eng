# Easy English — copy to `.env` / `.env.local` and fill in values.
# Never commit real secrets.

# Skip Zod env checks during `next build` / Docker image build only.
# SKIP_ENV_VALIDATION=1

NODE_ENV=development

# Postgres (Phase 1+)
DATABASE_URL=postgres://easy:easy@localhost:5432/easy_english
DATABASE_URL_TEST=postgres://easy:easy@localhost:5432/easy_english_test

# Better Auth (Phase 3+)
# BETTER_AUTH_URL should match the URL you open in the browser.
# Dev also trusts localhost:3000/3001 (Next may pick :3001 if :3000 is busy).
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Email verification after sign-up (default off for personal use)
# REQUIRE_EMAIL_VERIFICATION=true

# Google OAuth (optional — leave empty to hide “Continue with Google”)
# 1. https://console.cloud.google.com/ → APIs & Services → Credentials
# 2. Create OAuth client ID (Web application)
# 3. Authorized JavaScript origins: http://localhost:3000
# 4. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
# 5. Paste Client ID / Secret below (and the same for your production URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailer (SMTP in production; console driver used when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Easy English <noreply@example.com>"

# Local file storage root (Docker volume in compose)
STORAGE_DIR=./storage

# Default timezone for streaks / "today"
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Demo user for `pnpm db:seed -- --demo` (Phase 2+)
SEED_DEMO_EMAIL=linh@example.com
SEED_DEMO_PASSWORD=password123

# Docker Compose extras
# WEB_PORT=3000
# DB_PORT=5432
# POSTGRES_USER=easy
# POSTGRES_PASSWORD=easy
# POSTGRES_DB=easy_english
# BACKUP_RETENTION_DAYS=7

# Admin CMS (Phase 9): `pnpm db:seed -- --admin` promotes this user (or creates it
# when SEED_ADMIN_PASSWORD is set). Or: pnpm db:promote-admin you@example.com
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=change-me-min-8-chars
