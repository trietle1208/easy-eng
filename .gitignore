# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local uploads (Docker volume / STORAGE_DIR)
/storage/

# bundled Docker migrator (produced at image build)
/scripts/migrate.cjs

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling
.pnpm-store/
.gitnexus/
.gitnexus-home/

# vocabulary content pipeline intermediates (manifests + topic report committed)
content-pipeline/work/*
!content-pipeline/work/manifest.json
!content-pipeline/work/phase3-manifest.json
!content-pipeline/work/phase4-manifest.json
!content-pipeline/work/phase5-manifest.json
!content-pipeline/work/phase6-manifest.json
!content-pipeline/work/topic-report.csv
!content-pipeline/work/pilot.csv
!content-pipeline/work/validation-report.md
!content-pipeline/work/review-queue.csv
!content-pipeline/work/quality-gate.md
!content-pipeline/work/review-filled.csv
!content-pipeline/work/review-dropped.jsonl
